# Google Workspace OAuth (Calendar, Drive e Gmail em leitura).
VARYNTH_PUBLIC_URL=https://varynth-ynqv-plum.vercel.app/dashboard
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Use uma sequência longa e exclusiva (mínimo recomendado: 32 caracteres).
VARYNTH_TOKEN_ENCRYPTION_KEY=
# Obrigatório na Vercel; criado ao conectar Upstash Redis ao projeto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Também são aceitas as variáveis KV_REST_API_* ou as geradas pela integração
# nativa da Vercel com o prefixo UPSTASH_REDIS_REST.
# Ative junto com VARYNTH_AUTH_ENABLED, depois de configurar o Google Workspace.
VARYNTH_GOOGLE_WORKSPACE_ENABLED=false

# Autenticação da plataforma. Gere valores longos e exclusivos.
# Mantenha false até configurar todos os valores abaixo na Vercel.
VARYNTH_AUTH_ENABLED=false
# Necessário para manter as conversas da Athena privadas e disponíveis em todos os dispositivos.
# Ative apenas com NEXTAUTH_SECRET e provedor de login configurados; use também o Redis acima.
NEXTAUTH_URL=https://varynth-ynqv-plum.vercel.app
NEXTAUTH_SECRET=
VARYNTH_SIGNUP_INVITE_CODE=
# Lista separada por vírgulas; somente estes e-mails podem entrar pelo Google.
VARYNTH_ALLOWED_EMAILS=
# O mesmo cliente Google pode ser usado, desde que o callback /api/auth/callback/google seja autorizado.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Compatibilidade com configurações OAuth já existentes na Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Armazenamento persistente de livros (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
# Opcional: chave do provedor de imagens da plataforma. Sem ela, cada conta pode conectar a própria chave protegida no Music.
OPENAI_API_KEY=
MUSIC_IMAGE_MODEL=gpt-image-2
