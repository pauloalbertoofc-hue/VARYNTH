# Google Workspace OAuth (Calendar, Drive e Gmail em leitura).
VARYNTH_PUBLIC_URL=https://varynth-ynqv-plum.vercel.app/dashboard
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Use uma sequência longa e exclusiva (mínimo recomendado: 32 caracteres).
VARYNTH_TOKEN_ENCRYPTION_KEY=
# Obrigatório na Vercel; criado ao conectar Upstash Redis ao projeto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Ative somente depois de proteger as rotas com autenticação de usuário.
VARYNTH_GOOGLE_WORKSPACE_ENABLED=false

# Autenticação da plataforma. Gere valores longos e exclusivos.
NEXTAUTH_URL=https://varynth-ynqv-plum.vercel.app
NEXTAUTH_SECRET=
VARYNTH_SIGNUP_INVITE_CODE=
# Lista separada por vírgulas; somente estes e-mails podem entrar pelo Google.
VARYNTH_ALLOWED_EMAILS=
# O mesmo cliente Google pode ser usado, desde que o callback /api/auth/callback/google seja autorizado.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
